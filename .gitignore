# REFACTOR_FINAL F6 removed `.bw_projects/`. The runtime is bw2data-free;
# source/biosphere3-flows.json + source/ecoinvent-3.9.1-*-flows.json hold
# the snapshotted state instead.
.bw_projects/

# ── ecoinvent EULA: licensed data — NEVER COMMIT ──
# Exchange amounts, CFs attached through ecoinvent's LCIA implementation, and
# ecoinvent's dataset list (kept local: not confirmed as published).
# Regenerate from your own ecoinvent credentials per BOOTSTRAP.md.
source/ecoinvent-3.9.1-cutoff-exchanges.parquet
source/ecoinvent-3.9.1-cutoff-activities.json
source/ef-v31-methods.json
# ecoinvent elementary flows: names, units, compartments (no amounts).
# ecoinvent publishes these under the ODbL (Data Glossary), so the guard does
# not block them; ignored because BOOTSTRAP.md regenerates them.
source/ecoinvent-3.9.1-biosphere-flows.json
# Entire per-method CF tree is ecoinvent-3.9.1-keyed + rebuilt by
# `dds-build-registry` (subdirs hold CF rows keyed by ecoinvent biosphere
# UUID; _index.json is their manifest). None of it ships; the pre-commit
# guard refuses every subdir.
registry/method_cfs/

# Source-of-truth data — large files tracked locally only.
source/AGB32_final.CSV
source/harmonised-flows-simple.json.gz

# Local what-if parameter overrides (dds-set-parameter); cleared by dds-reset.
source/parameter_overrides.csv

# Built registry — regeneratable from source/ via `dds-build-registry`.
# Bit-identical re-builds, so we keep parquets out of git. Three of them are
# also refused by the pre-commit guard: cf_comparison_join.parquet (registry
# CF per flow) and ecoinvent_catalog / activity_catalog (the dataset list).
registry/*.parquet

# Run-time artifacts under dashboard/, to_review/, unlinked/.
# Directory tracked via .gitkeep; contents ignored unless explicitly checked in.
#
# The dashboard's generated data (cf_comparison.csv, decomp/,
# product_reasons.json) is NOT shipped: those files carry numbers from the
# licensed build (CF rows joined through ecoinvent's LCIA implementation,
# per-flow contributions of ecoinvent-linked products) and are regenerated
# locally by a licensed user via `dds-compare-cfs` /
# `dds-build-cf-comparison-csv` / `dds-build-flow-decomp` /
# `dds-build-product-reasons`; the pre-commit guard refuses them, as it does
# to_review/cf_comparison/. Only the static UI shell + vendored JS ship.
dashboard/*
!dashboard/.gitkeep
!dashboard/backtest_dashboard.html
!dashboard/backtest_pass1.csv
!dashboard/outlier_reasons.json
!dashboard/dds-logo.svg
!dashboard/react.min.js
!dashboard/react-dom.min.js
!dashboard/babel.min.js
to_review/*
!to_review/.gitkeep
unlinked/*
!unlinked/.gitkeep

# Caches rebuilt by the pipeline: parquet copies of upstream xlsx, the SimaPro
# CSV parse and linked-graph pickles, and the scoring packages. The pickles and
# the scoring packages carry licensed ecoinvent amounts and CFs; the pre-commit
# guard refuses everything under cache/.
cache/

# Brightway export (dds-build-bw-package) — contains licensed ecoinvent
# amounts; never commit or redistribute. The pre-commit guard refuses a
# bw_package/ directory at any depth, bw_package.* archives, and the export's
# matrix files under any --out name.
bw_package/

